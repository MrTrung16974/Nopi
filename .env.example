NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
DATABASE_URL=postgres://nopi:nopi@localhost:5432/nopi
REDIS_URL=redis://localhost:6379
API_PORT=3000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nopi-media
S3_ACCESS_KEY=nopi
S3_SECRET_KEY=nopi-dev-secret
CORS_ORIGINS=http://localhost:3200,http://localhost:8081
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
GOOGLE_CLIENT_IDS=
# Kênh gửi OTP theo thứ tự ưu tiên: console (dev) | zalo | sms
OTP_CHANNELS=console
S3_REGION=ap-southeast-1
S3_CREATE_BUCKET=true
# Thông báo đẩy: console (dev) | expo
PUSH_PROVIDER=console
# Tin Zalo cho phụ huynh chưa cài app: none | console (dev)
ZALO_NOTIFY_PROVIDER=console
# Cổng thanh toán web: fake (dev, giả lập) | momo | zalopay | vnpay — production cấm 'fake'
PAYMENT_PROVIDERS=fake
# Xác minh mua trong app: none | fake (dev)
STORE_VERIFIER=fake
API_PUBLIC_URL=http://localhost:3000
# Đọc đề từ ảnh: none | fake (dev, đề mẫu) | claude (cần ANTHROPIC_API_KEY hoặc `ant auth login`)
SCAN_ENGINE=fake
