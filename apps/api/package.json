{
  "name": "@nopi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "grant-system-admin": "node --env-file-if-exists=../../.env dist/scripts/grant-system-admin.js",
    "loadtest": "node --env-file-if-exists=../../.env scripts/loadtest.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@fastify/multipart": "^10.1.9",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-fastify": "^12.6.0",
    "@node-rs/argon2": "^2.2.2",
    "@nopi/contracts": "workspace:*",
    "@nopi/copy": "workspace:*",
    "@nopi/db": "workspace:*",
    "@nopi/domain": "workspace:*",
    "bullmq": "^6.7.9",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "5.12.8",
    "ioredis": "^6.1.0",
    "jose": "^6.2.18",
    "pdfkit": "^0.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.0",
    "@nopi/config": "workspace:*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "autocannon": "^8.0.0",
    "eslint": "^10.15.0",
    "postgres": "^3.4.9",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
