{
  "expo": {
    "name": "Nopi",
    "slug": "nopi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.nopi.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.nopi.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "nopi",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Nopi cần dùng camera để quét mã QR, chụp và quay bài làm",
          "microphonePermission": "Nopi cần dùng micro để ghi âm bài đọc và quay video bài làm",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Nopi cần dùng micro để ghi âm bài đọc của con"
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#EA580C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
