{
  "name": "@nopi/upload-queue",
  "version": "0.0.0",
  "private": true,
  "description": "Hàng đợi nộp bài chịu được mạng yếu: xin URL → tải file → xác nhận → nộp, lưu tiến độ từng bước, tự thử lại",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": { "@nopi/contracts": "workspace:*" },
  "devDependencies": {
    "@nopi/config": "workspace:*",
    "eslint": "^10.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
