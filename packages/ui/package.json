    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": { "@nopi/domain": "workspace:*" },
  "devDependencies": {
    "@nopi/config": "workspace:*",
    "eslint": "^10.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
