{
  "name": "@nopi/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens cho 3 chế độ giao diện (Nhí, Teen, người lớn) — dùng chung app và web",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
